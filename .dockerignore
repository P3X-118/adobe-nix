# Docker build context exclusions for LinuxPDF project
# Excludes unnecessary files to improve build performance

# Build artifacts (will be created in container)
out/
build/
cache/
logs/
final/
*.pdf
*.js

# Git artifacts
.git/
.gitignore
.gitattributes

# Docker files (already in context)
docker-compose*.yml
Dockerfile*
.dockerignore

# Documentation and examples
*.md
docs/
examples/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.log
*.bak
*.backup

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.venv/
venv/
env/

# Node modules (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Large binary files and archives
*.tar.gz
*.zip
*.rar
*.7z
*.bin
*.iso

# Emscripten build artifacts (will be built in container)
emsdk/.git/
emsdk/emscripten/
emsdk/node/
emsdk/fastcomp/

# TinyEMU build artifacts
tinyemu/*.js.o
tinyemu/*.d
tinyemu/js/*.wasm
tinyemu/js/riscvemu*.js

# Test files and benchmarks
test/
tests/
benchmarks/
coverage/

# CI/CD files
.github/
.gitlab-ci.yml
.travis.yml
.circleci/

# Local configuration
.env
.env.local
.env.development
.env.test
.env.production

# Profiling and debugging
*.prof
*.trace
core
core.*